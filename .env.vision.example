# Copy to .env.vision and replace every CHANGE_ME value before launch.

# --- Hugging Face / local layout ---
HF_CACHE=/path/to/huggingface-cache
PLUGIN_DIR=/path/to/repository/plugin
TOWER_DIR=/path/to/vision-assets/tower
CKPT_DIR=/path/to/vision-assets/adapter

# Container paths (match docker-compose mounts).
DSV4_VISION_ADAPTER=/ckpt/merged-004800-5af0c5.pt

# --- Image ---
DSPARK_VLLM_IMAGE=dsv4-vision-vllm:0.1.1
SERVED_MODEL_NAME=deepseek-v4-flash-0731-vision
VLLM_HOST=0.0.0.0
VLLM_PORT=8899
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.80
MM_IMAGE_LIMIT=8

# --- Two-node fabric (REQUIRED) ---
MASTER_ADDR=CHANGE_ME_HEAD_FABRIC_IP
MASTER_PORT=25100
WORKER_HOST=CHANGE_ME_WORKER_SSH_TARGET
WORKER_DIR=/path/to/repository
HEAD_FABRIC_IP=CHANGE_ME_HEAD_FABRIC_IP
WORKER_FABRIC_IP=CHANGE_ME_WORKER_FABRIC_IP

# Override these if the worker uses different paths.
WORKER_HF_CACHE=/path/to/worker/huggingface-cache
WORKER_PLUGIN_DIR=/path/to/worker/repository/plugin
WORKER_TOWER_DIR=/path/to/worker/vision-assets/tower
WORKER_CKPT_DIR=/path/to/worker/vision-assets/adapter

# --- NCCL / RoCE (discover these on each target system) ---
NCCL_IB_HCA=CHANGE_ME_ROCE_DEVICE
NCCL_SOCKET_IFNAME=CHANGE_ME_FABRIC_INTERFACE
NCCL_IB_GID_INDEX=CHANGE_ME_GID_INDEX

CHAT_TEMPLATE_FLAG=
