# Rank 1 example. Replace placeholders for your fabric and local paths.
NODE_RANK=1
HEADLESS=1
MASTER_ADDR=HEAD_FABRIC_IP
MASTER_PORT=25010
VLLM_HOST_IP=WORKER_FABRIC_IP

NCCL_IB_HCA=CHANGE_ME_ROCE_DEVICE_LIST
NCCL_IB_GID_INDEX=CHANGE_ME_GID_INDEX
NCCL_CROSS_NIC=1
NCCL_SOCKET_IFNAME=WORKER_FABRIC_INTERFACE
TP_SOCKET_IFNAME=WORKER_FABRIC_INTERFACE
GLOO_SOCKET_IFNAME=WORKER_FABRIC_INTERFACE
NCCL_DEBUG=INFO

DSPARK_VLLM_IMAGE=anemll-dsv4-vision:0.1.1-dspark-headfix1
# Optional host-local integrity gate; local Docker image IDs are not portable.
DSPARK_VLLM_IMAGE_ID=
DSPARK_MODEL_HOST=/path/to/DeepSeek-V4-Flash-0731-abliterated-vision
HF_CACHE=/path/to/huggingface-cache
DSPARK_TMP_HOST=/path/to/dspark-tmp
SERVED_MODEL_NAME=DeepSeek-V4-Flash-0731-Vision
DSV4_VISION_TILES=2
MM_IMAGE_LIMIT=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

MAX_MODEL_LEN=800000
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=12288
GPU_MEMORY_UTILIZATION=0.88
MTP_NUM_TOKENS=5
ENFORCE_EAGER=
JIT_MONITOR_MODE=warn

VLLM_HOST=0.0.0.0
VLLM_PORT=8000
